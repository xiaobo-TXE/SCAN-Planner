<?xml version="1.0"?>
<!-- ============================================================================
文件：xacro/gazebo.xacro —— Gazebo 仿真相关的插件与传感器

【这个文件定义了什么】
1) 四个足端的“接触力传感器”（用来观察脚有没有着地）
2) IMU 传感器
3) gz_ros2_control 插件：让 Gazebo 里的关节能被 ROS 2 控制器驱动
============================================================================ -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 一个足的接触传感器：给某条腿的脚设置摩擦系数并加接触传感器 -->
  <xacro:macro name="go2_foot_contact" params="leg">
    <gazebo reference="${leg}_foot">
      <mu1>0.6</mu1>
      <mu2>0.6</mu2>
      <!-- 接触传感器发布在 /go2/{腿名}_foot_contact 话题上 -->
      <sensor name="${leg}_foot_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/go2/${leg}_foot_contact</topic>
        <contact>
          <collision>${leg}_foot_collision</collision>
        </contact>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- 【主宏】把所有 Gazebo 相关配置一次性加上 -->
  <xacro:macro name="go2_gazebo">
    <gazebo>
      <!-- gz_ros2_control 插件：把 Gazebo 的关节与 ROS 2 控制器连起来 -->
      <plugin filename="libgz_ros2_control-system.so"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find go2_description)/config/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>

    <!-- IMU 传感器：200Hz，发布在 /go2/imu -->
    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/go2/imu</topic>
        <imu/>
      </sensor>
    </gazebo>

    <!-- 给四条腿分别加上足端接触传感器 -->
    <xacro:go2_foot_contact leg="FL"/>
    <xacro:go2_foot_contact leg="FR"/>
    <xacro:go2_foot_contact leg="RL"/>
    <xacro:go2_foot_contact leg="RR"/>
  </xacro:macro>
</robot>
