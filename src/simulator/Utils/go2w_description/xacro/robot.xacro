<?xml version="1.0"?>

<!-- ============================================================================
文件：xacro/robot.xacro —— Go2 四足机器人的模型定义（xacro = 带变量的 URDF）

【这个文件是干什么的】
描述机器人由哪些“刚体(link)”和“关节(joint)”组成，以及各自的形状、质量。
它由 launch 文件用 xacro 命令展开成 URDF，再交给 robot_state_publisher。

【本项目的两种用法】
use_gazebo 为 true  → 完整模型 + 物理仿真（Gazebo）
use_gazebo 为 false → 只用于 RViz 显示（规划器启动时用的就是这种）

【结构层次】
base（虚拟根）→ trunk（躯干）→ { imu_link, front_camera, 四条腿 }
============================================================================ -->
<robot name="go2" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="DEBUG" default="false"/>
    <!-- 开关：是否生成 Gazebo 仿真相关的部分 -->
    <xacro:arg name="use_gazebo" default="true"/>

    <!-- 引入其它 xacro：常量尺寸、材质、腿部宏、控制器、Gazebo 插件 -->
    <xacro:include filename="$(find go2w_description)/xacro/const.xacro"/>
    <xacro:include filename="$(find go2w_description)/xacro/materials.xacro"/>
    <xacro:include filename="$(find go2w_description)/xacro/leg.xacro"/>
    <xacro:include filename="$(find go2w_description)/xacro/ros2_control.xacro"/>
    <xacro:include filename="$(find go2w_description)/xacro/gazebo.xacro"/>
    <!-- <xacro:include filename="$(find go2_gazebo)/launch/stairs.urdf.xacro"/> -->

    <!-- <xacro:stairs stairs="15" xpos="0" ypos="0" zpos="0" /> -->

    <!-- Rotor related joint and link is only for demonstrate location. -->
    <!-- Actually, the rotor will rotate and the joint is not fixed. Reduction ratio should be considered. -->

    <!-- Debug mode will hung up the robot, use "true" or "false" to switch it. -->
    <!-- 调试模式：把机器人固定在原点（先钉一个 world 坐标系） -->
    <xacro:if value="$(arg DEBUG)">
        <link name="world"/>
        <joint name="base_static_joint" type="fixed">
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <parent link="world"/>
            <child link="base"/>
        </joint>
    </xacro:if> 

    <!-- 虚拟根刚体：一个几乎为零大小的方盒，用来挂住整个机器人 -->
    <link name="base">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="0.001 0.001 0.001"/>
            </geometry>
        </visual>
    </link>

    <!-- 把躯干固定在虚拟根上 -->
    <joint name="floating_base" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <parent link="base"/>
        <child link="trunk"/>
    </joint>

    <!-- 躯干：外观用 base.dae 网格；碰撞体用简化长方体；质量由 const.xacro 提供 -->
    <link name="trunk">
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <mesh filename="package://go2_description/meshes/base.dae" scale="1 1.387 1.250"/>
            </geometry>
            <!-- <material name="orange"/> -->
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="${trunk_length} ${trunk_width} ${trunk_height}"/>
            </geometry>
        </collision>
        <inertial>
            <origin rpy="0 0 0" xyz="${trunk_com_x} ${trunk_com_y} ${trunk_com_z}"/>
            <mass value="${trunk_mass}"/>
            <inertia
                ixx="${trunk_ixx}" ixy="${trunk_ixy}" ixz="${trunk_ixz}"
                iyy="${trunk_iyy}" iyz="${trunk_iyz}"
                izz="${trunk_izz}"/>  
        </inertial>
    </link>

    <!-- IMU：挂一个近乎无质量的虚拟刚体，Gazebo 会给它发布 IMU 数据 -->
    <joint name="imu_joint" type="fixed">
        <parent link="trunk"/>
        <child link="imu_link"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="imu_link">
        <inertial>
            <mass value="0.001"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size="0.001 0.001 0.001"/>
            </geometry>
            <!-- <material name="red"/> -->
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size=".001 .001 .001"/>
            </geometry>
        </collision>
    </link>

    <!-- 前置相机：只占一个坐标位置（本项目不真的用它出图） -->
    <joint name="front_camera_joint" type="fixed">
        <parent link="trunk"/>
        <child link="front_camera"/>
        <origin rpy="0 0 0" xyz="0.32715 -0.00003 0.04297"/>
    </joint>

    <link name="front_camera">
    </link>

    <!--
    <joint name="load_joint" type="fixed">
        <parent link="trunk"/>
        <child link="load_link"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="load_link">
        <inertial>
            <mass value="5"/>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
        <visual>
            <origin rpy="0 0 0" xyz="0 0 0.2"/>
            <geometry>
                <box size="0.5 0.3 0.2"/>
            </geometry>
        </visual>
        <collision>
            <origin rpy="0 0 0" xyz="0 0 0"/>
            <geometry>
                <box size=".001 .001 .001"/>
            </geometry>
        </collision>
    </link>
-->
    <!-- 四条腿：由 leg.xacro 的宏生成，参数区分左/右(mirror)和前/后(front_hind) -->
    <xacro:leg name="FR" mirror="-1" mirror_dae= "False" front_hind="1"  front_hind_dae="True"  />
    <xacro:leg name="FL" mirror="1"  mirror_dae="True"   front_hind="1"  front_hind_dae="True"  />
    <xacro:leg name="RR" mirror="-1" mirror_dae="False"  front_hind="-1" front_hind_dae="False" />
    <xacro:leg name="RL" mirror="1"  mirror_dae="True"   front_hind="-1" front_hind_dae="False" />

    <!-- 只在开启 Gazebo 时才生成控制器与仿真插件部分 -->
    <xacro:if value="$(arg use_gazebo)">
        <xacro:go2_ros2_control/>
        <xacro:go2_gazebo/>
    </xacro:if>
</robot>
