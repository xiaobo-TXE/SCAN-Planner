<?xml version="1.0"?>
<!-- ============================================================================
  文件：src/simulator/Utils/a2_description/package.xml

  包 a2_description：Unitree A2 的 URDF 模型与网格，供 SCAN-Planner 仿真在
  RViz2 里显示 A2 外形（与 go2_description 对应）。
============================================================================ -->
<package format="3">
  <name>a2_description</name>
  <version>1.0.0</version>
  <description>Unitree A2 description (URDF + meshes) for RViz2, used by SCAN-Planner simulation.</description>
  <maintainer email="iszhouxin@zju.edu.cn">SCAN-Planner maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <architecture_independent/>
  </export>
</package>
